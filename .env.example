# Conexión a Base de Datos PostgreSQL (Desarrollo Local)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:password123@localhost:5432/subven2_db?schema=public"

# Variables de entorno para Docker Compose en Servidor (192.168.1.201:3006)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=subven2_db
APP_PORT=3006
AUTO_SEED=true
